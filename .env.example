# SQLite fájl útvonala (projektgyökérhez relatív)
DATABASE_URL=./data/tet.db

# Better Auth – generáld: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
# Az app alap URL-je (fallback, ha nincs bejövő kérés, pl. seed/CLI). A hosztja
# automatikusan engedélyezett.
BETTER_AUTH_URL=http://localhost:3000
# További engedélyezett hosztok vesszővel, wildcard megengedett. A Better Auth a kérés
# Host fejlécéből építi az origint, de csak ezekre; más Host → 403 INVALID_ORIGIN.
# Éles/ideiglenes hostingon ide írd a publikus domain(eke)t, pl.:
# BETTER_AUTH_ALLOWED_HOSTS=tet.niu.hu,*.hostingersite.com
BETTER_AUTH_ALLOWED_HOSTS=

# Seed admin (npm run db:seed)
SEED_ADMIN_EMAIL=admin@niu.hu
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_ADMIN_NAME=Sipos Katalin
# kelszó Admin12345!

