# SQLite fájl útvonala (projektgyökérhez relatív)
DATABASE_URL=./data/tet.db

# Better Auth – generáld: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
# Az app publikus origin-je. Ebből jön a trustedOrigins és a cookie secure-prefixe:
# éles környezetben a HTTPS-es publikus címre állítsd (pl. https://tet.niu.hu),
# különben minden bejelentkezést 403 INVALID_ORIGIN-nal utasít el.
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (npm run db:seed)
SEED_ADMIN_EMAIL=admin@niu.hu
SEED_ADMIN_PASSWORD=change-me-min-8-chars
SEED_ADMIN_NAME=Sipos Katalin
# kelszó Admin12345!

# Email	Szerep	Ország
# teszt.attase@niu.hu	attase	Dél-Korea
# masodik.attase@niu.hu	attase	Japán
# Attase12345!